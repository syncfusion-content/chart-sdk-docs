@using Syncfusion.EJ2;
@Html.EJS().HeatMap("container").TooltipRender("tooltipRender").TitleSettings(ts =>
  ts.Text("Sales Revenue per Employee (in 1000 US$)").TextStyle(ViewBag.textStyle)).XAxis(xAxis =>
    xAxis.Labels(ViewBag.xLabels)).YAxis(yaxis =>
      yaxis.Labels(ViewBag.yLabels)).DataSource(ViewBag.dataSource).CellSettings(cs =>
        cs.ShowLabel(true).Format("${value}K")).DataSourceSettings(ds =>
          ds.IsJsonData(true).AdaptorType(Syncfusion.EJ2.HeatMap.AdaptorType.Cell).XDataMapping("Employee").YDataMapping("Month").ValueMapping("Revenue")).Render()

<script>
    function tooltipRender(args) {
        var record = args.data;
        if (record) {
            args.content = [
                'Employee : ' + record.Employee,
                'Month : ' + record.Month,
                'Revenue : $' + record.Revenue + 'K',
                'Target : $' + record.Target + 'K',
                'Region : ' + record.Region
            ];
        }
    }
</script>
