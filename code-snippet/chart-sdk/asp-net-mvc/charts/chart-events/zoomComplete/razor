@(Html.EJS().Chart("container")
    .Title("Sales Analysis")
    .PrimaryXAxis(px => px.ValueType(Syncfusion.EJ2.Charts.ValueType.Category).Title("Month"))
    .PrimaryYAxis(py2 => py2.LabelFormat("${value}K"))
    .ZoomSettings(zoom => zoom.EnableSelectionZooming(true).EnablePan(true).Mode(Syncfusion.EJ2.Charts.ZoomMode.X))
    .LegendSettings(legend => legend.Visible(true))
    .Series(series =>
    {
        series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.Line)
            .DataSource(ViewBag.dataSource)
            .XName("month")
            .YName("sales")
            .Name("Sales")
            .Marker(marker => marker.DataLabel(dataLabel => dataLabel.Visible(true))).Add();
    })
    .ZoomComplete("zoomCompleteHandler")
    .Render())

<script>
    function zoomCompleteHandler(args) {
        console.log('zoomComplete event was triggered');
    }
</script>