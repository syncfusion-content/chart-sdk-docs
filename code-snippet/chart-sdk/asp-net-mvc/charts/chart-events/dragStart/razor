@(Html.EJS().Chart("container")
    .Title("Monthly Sales")
    .PrimaryXAxis(px => px.ValueType(Syncfusion.EJ2.Charts.ValueType.Category).Title("Month"))
    .PrimaryYAxis(py2 => py2.Title("Sales"))
    .Series(series =>
    {
        series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.Line)
            .DataSource(ViewBag.dataSource)
            .XName("month")
            .YName("sales")
            .Name("Sales")
            .DragSettings(drag => drag.Enable(true).MinY(0).MaxY(60)).Add();
    })
    .DragStart("dragStartHandler")
    .Render())

<script>
    function dragStartHandler(args) {
        console.log('dragStart event was triggered');
    }
</script>