@(Html.EJS().Chart("container")
    .Title("Monthly Sales")
    .PrimaryXAxis(px => px.ValueType(Syncfusion.EJ2.Charts.ValueType.Category).Title("Month"))
    .PrimaryYAxis(py2 => py2.Title("Sales"))
    .Annotations(annotation =>
    {
        annotation.Content("Peak sales in August").CoordinateUnits(Syncfusion.EJ2.Charts.Units.Point)
            .X("Aug").Y("55").Add();
    })
    .Series(series =>
    {
        series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.Line)
            .DataSource(ViewBag.dataSource)
            .XName("month")
            .YName("sales")
            .Name("Sales").Add();
    })
    .AnnotationRender("annotationRenderHandler")
    .Render())

<script>
    function annotationRenderHandler(args) {
        console.log('annotationRender event was triggered');
    }
</script>