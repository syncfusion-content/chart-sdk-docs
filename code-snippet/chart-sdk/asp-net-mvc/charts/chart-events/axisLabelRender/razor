@(Html.EJS().Chart("container")
    .Title("Monthly Sales")
    .PrimaryXAxis(px => px.ValueType(Syncfusion.EJ2.Charts.ValueType.Category).Title("Month"))
    .PrimaryYAxis(py2 => py2.Title("Sales"))
    .Series(series =>
    {
        series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.Line)
            .DataSource(ViewBag.dataSource)
            .XName("month")
            .YName("sales")
            .Name("Sales").Add();
    })
    .AxisLabelRender("axisLabelRenderHandler")
    .Render())

<script>
    function axisLabelRenderHandler(args) {
        if (args.axis.valueType === 'Category' && typeof args.text === 'string') {
            // Hide the label for August
            if (args.text === 'Aug') {
                args.cancel = true;
                return;
            }
            args.text = args.text.toUpperCase();
        }
        console.log('axisLabelRender event was triggered');
    }
</script>