@(Html.EJS().Chart("container")
    .Title("Monthly Sales")
    .PrimaryXAxis(px => px.ValueType(Syncfusion.EJ2.Charts.ValueType.Category).Title("Month"))
    .PrimaryYAxis(py2 => py2.Title("Sales"))
    .PrimaryXAxis(px => px.ValueType(Syncfusion.EJ2.Charts.ValueType.Category)
        .ScrollbarSettings(scrollbar => scrollbar.Enable(true)))
    .ZoomSettings(zoom => zoom.EnableSelectionZooming(true).EnableMouseWheelZooming(true))
    .Series(series =>
    {
        series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.Line)
            .DataSource(ViewBag.dataSource)
            .XName("month")
            .YName("sales")
            .Name("Sales")
            .Marker(marker => marker.DataLabel(dataLabel => dataLabel.Visible(true))).Add();
    })
    .ScrollChanged("scrollChangedHandler")
    .Render())

<script>
    function scrollChangedHandler(args) {
        console.log('scrollChanged event was triggered');
    }
</script>