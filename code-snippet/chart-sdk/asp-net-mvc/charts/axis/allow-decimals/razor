@Html.EJS().Chart("container").PrimaryXAxis(px => px.ValueType(Syncfusion.EJ2.Charts.ValueType.Category)).PrimaryYAxis(py => py.Title("Orders").AllowDecimals(false)).Series(sr =>
{
    sr.DataSource(ViewBag.DataSource).XName("x").YName("y").Type(Syncfusion.EJ2.Charts.ChartSeriesType.Column).Add();
}).Render()