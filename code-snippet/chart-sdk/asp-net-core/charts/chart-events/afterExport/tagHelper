<div><ejs-button id="export" content="Export" isPrimary="true"></ejs-button></div>
<ejs-chart id="container" title="Monthly Sales" afterExport="afterExportHandler">
    <e-chart-primaryxaxis valueType="@Syncfusion.EJ2.Charts.ValueType.Category" title="Month"></e-chart-primaryxaxis>
    <e-chart-primaryyaxis title="Sales"></e-chart-primaryyaxis>
    <e-chart-legendsettings visible="true"></e-chart-legendsettings>
    <e-series-collection>
        <e-series dataSource="ViewBag.dataSource" name="Sales" xName="month" yName="sales"
                   type="@Syncfusion.EJ2.Charts.ChartSeriesType.Line">
        </e-series>
    </e-series-collection>
</ejs-chart>

<script>
    function afterExportHandler(args) {
        console.log('afterExport event was triggered');
    }
    document.getElementById('export').onclick = () => { var chart = document.getElementById('container').ej2_instances[0]; chart.export('PNG', 'Chart'); };
</script>