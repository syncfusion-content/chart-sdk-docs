
<ejs-chart id="container" title="Sales Analysis" zoomComplete="zoomCompleteHandler">
    <e-chart-primaryxaxis valueType="@Syncfusion.EJ2.Charts.ValueType.Category" title="Month"></e-chart-primaryxaxis>
    <e-chart-primaryyaxis labelFormat="${value}K"></e-chart-primaryyaxis>
    <e-chart-zoomsettings enableSelectionZooming="true" enablePan="true" mode="X"></e-chart-zoomsettings>
    <e-chart-legendsettings visible="true"></e-chart-legendsettings>
    <e-series-collection>
        <e-series dataSource="ViewBag.dataSource" name="Sales" xName="month" yName="sales"
                   type="@Syncfusion.EJ2.Charts.ChartSeriesType.Line">
            <e-series-marker>
                <e-marker-datalabel visible="true"></e-marker-datalabel>
            </e-series-marker>
        </e-series>
    </e-series-collection>
</ejs-chart>

<script>
    function zoomCompleteHandler(args) {
        console.log('zoomComplete event was triggered');
    }
</script>