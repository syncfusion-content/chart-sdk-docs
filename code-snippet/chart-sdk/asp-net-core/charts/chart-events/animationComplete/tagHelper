
<ejs-chart id="container" title="Monthly Sales" animationComplete="animationCompleteHandler">
    <e-chart-primaryxaxis valueType="@Syncfusion.EJ2.Charts.ValueType.Category" title="Month"></e-chart-primaryxaxis>
    <e-chart-primaryyaxis title="Sales"></e-chart-primaryyaxis>
    <e-series-collection>
        <e-series dataSource="ViewBag.dataSource" name="Sales" xName="month" yName="sales"
                   type="@Syncfusion.EJ2.Charts.ChartSeriesType.Line">
            <e-series-animation enable="true" duration="1000"></e-series-animation>
        </e-series>
    </e-series-collection>
</ejs-chart>

<script>
    function animationCompleteHandler(args) {
        console.log('animationComplete event was triggered');
    }
</script>