
<ejs-chart id="container" title="Monthly Sales" annotationRender="annotationRenderHandler">
    <e-chart-primaryxaxis valueType="@Syncfusion.EJ2.Charts.ValueType.Category" title="Month"></e-chart-primaryxaxis>
    <e-chart-primaryyaxis title="Sales"></e-chart-primaryyaxis>
    <e-chart-annotations>
        <e-chart-annotation content="Peak sales in August" coordinateUnits="Point" x="Aug" y="55"></e-chart-annotation>
    </e-chart-annotations>
    <e-series-collection>
        <e-series dataSource="ViewBag.dataSource" name="Sales" xName="month" yName="sales"
                   type="@Syncfusion.EJ2.Charts.ChartSeriesType.Line">
        </e-series>
    </e-series-collection>
</ejs-chart>

<script>
    function annotationRenderHandler(args) {
        console.log('annotationRender event was triggered');
    }
</script>