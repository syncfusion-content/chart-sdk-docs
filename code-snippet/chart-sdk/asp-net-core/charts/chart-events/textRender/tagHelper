
<ejs-chart id="container" title="Monthly Sales" textRender="textRenderHandler">
    <e-chart-primaryxaxis valueType="@Syncfusion.EJ2.Charts.ValueType.Category" title="Month"></e-chart-primaryxaxis>
    <e-chart-primaryyaxis title="Sales"></e-chart-primaryyaxis>
    <e-series-collection>
        <e-series dataSource="ViewBag.dataSource" name="Sales" xName="month" yName="sales"
                   type="@Syncfusion.EJ2.Charts.ChartSeriesType.Line">
            <e-series-marker visible="true">
                <e-marker-datalabel visible="true"></e-marker-datalabel>
            </e-series-marker>
        </e-series>
    </e-series-collection>
</ejs-chart>

<script>
    function textRenderHandler(args) {
        console.log('textRender event was triggered');
    }
</script>